# 应用配置
APP_ENV=development
API_PORT=8080
API_HOST=127.0.0.1
# 使用 openssl rand -hex 32 生成（启动 API 必填）
API_AUTH_TOKEN=
SESSION_COOKIE_SECURE=false
# Next.js 服务端代理目标（本地 npm 开发环境）；不得向浏览器暴露服务端密钥。
API_INTERNAL_URL=http://127.0.0.1:8080
WEB_PORT=3000
RUST_LOG=info
# 仅启用已授权的一次性站内提醒；不调用模型或外部通知。
SCHEDULER_MODE=disabled

# PostgreSQL 数据库
POSTGRES_DB=personal_ai
POSTGRES_USER=personal_ai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://personal_ai:change-me@postgres:5432/personal_ai

# Redis 缓存
REDIS_URL=redis://redis:6379/0
# 可选的消息快照缓存；关闭或故障时仍从 PostgreSQL 读取消息。
MESSAGE_CACHE_ENABLED=false
# disabled、fixture 或 openai；默认关闭，fixture 不调用模型。
CONVERSATION_REPLY_MODE=disabled
# 仅 openai 模式必填。固定 gpt-4o-mini-2024-07-18 和官方地址，独立密钥。
# 价格单位：USD 微单位/百万 token；额度单位：USD 微单位。无默认报价。
REPLY_OPENAI_API_KEY=
REPLY_CONFIGURATION_REVISION=
REPLY_PRICE_VERSION=
REPLY_INPUT_PRICE_MICRO_PER_MILLION=
REPLY_OUTPUT_PRICE_MICRO_PER_MILLION=
REPLY_REQUEST_LIMIT_MICRO=
REPLY_DAILY_LIMIT_MICRO=
# 经管理员核验的价格有效截止时间（Unix 毫秒）；同版本不能延长或重新启用。
REPLY_PRICE_VALID_UNTIL_UNIX_MS=

# Qdrant 向量数据库
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=personal_knowledge
QDRANT_API_KEY=

# MinIO / S3 兼容对象存储（显式启用后，新导入原文写入私有桶）
OBJECT_STORE_ENABLED=false
OBJECT_STORE_REGION=us-east-1
MINIO_ROOT_USER=personal_ai
MINIO_ROOT_PASSWORD=change-me-now
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=personal-ai
OBJECT_STORE_ACCESS_KEY=personal_ai
OBJECT_STORE_SECRET_KEY=change-me-now

# 大模型提供方（密钥仅保存在 .env 中，切勿提交）
KNOWLEDGE_INDEX_ENABLED=false
# 问答需同时启用索引并设置支持严格结构化输出的 OPENAI_CHAT_MODEL
KNOWLEDGE_ANSWER_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
# 启用索引时显式指定支持 dimensions 的模型与维度
EMBEDDING_DIMENSIONS=1536
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# 模型 Agent 默认关闭；openai 要求已启用官方 text-embedding-3-small / 1536 维知识索引。
# 价格/限额均为 USD 微单位，价格必须由部署者核对；没有默认市场价格。
MODEL_AGENT_MODE=disabled
MODEL_AGENT_OPENAI_API_KEY=
MODEL_AGENT_CONFIGURATION_VERSION=
MODEL_AGENT_CHAT_PRICE_VERSION=
MODEL_AGENT_CHAT_INPUT_PRICE_MICRO_PER_MILLION=
MODEL_AGENT_CHAT_OUTPUT_PRICE_MICRO_PER_MILLION=
MODEL_AGENT_EMBEDDING_PRICE_VERSION=
MODEL_AGENT_EMBEDDING_PRICE_MICRO_PER_MILLION=
MODEL_AGENT_PRICE_VALID_UNTIL_UNIX_MS=
MODEL_AGENT_PHASE_LIMIT_MICRO=
MODEL_AGENT_DAILY_LIMIT_MICRO=
MODEL_AGENT_DAILY_MODEL_CALLS=
MODEL_AGENT_DAILY_TOOL_CALLS=
