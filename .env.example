# Application
APP_ENV=development
API_PORT=8080
API_HOST=127.0.0.1
# Generate with: openssl rand -hex 32 (required to start API)
API_AUTH_TOKEN=
SESSION_COOKIE_SECURE=false
# Next.js server-side proxy destination (local npm dev); never a browser secret.
API_INTERNAL_URL=http://127.0.0.1:8080
WEB_PORT=3000
RUST_LOG=info

# PostgreSQL
POSTGRES_DB=personal_ai
POSTGRES_USER=personal_ai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://personal_ai:change-me@postgres:5432/personal_ai

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=personal_knowledge

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=personal_ai
MINIO_ROOT_PASSWORD=change-me-now
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=personal-ai
OBJECT_STORE_ACCESS_KEY=personal_ai
OBJECT_STORE_SECRET_KEY=change-me-now

# LLM provider (keep secrets in .env, never commit them)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
